    "class Person:\n",
    "    def __init__(self,name,age,gender):\n",
    "        self.__name=name    #private variable\n",
    "        self.__age=age\n",
    "        self._gender=gender   #protected variable\n",
    "    def get_name(person):\n",
    "      return person.name\n",
    "      \n",
    "person=Person(\"ujjwal\",21,\"male\") \n",
    "  \n",
    "dir(person)"
